</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

  const cart = document.querySelector('[data-cart-form]');

  if (!cart) {
    return;
  }


  const cartWrapper = document.querySelector('.test-2-cart');


  /* =======================================================
     UPDATE CART
     ======================================================= */

  async function updateCart(line, quantity) {

    if (quantity < 0) {
      quantity = 0;
    }

    if (cartWrapper) {
      cartWrapper.classList.add('is-loading');
    }

    try {

      const response = await fetch('{{ routes.cart_change_url }}.js', {

        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },

        body: JSON.stringify({
          line: line,
          quantity: quantity
        })

      });


      if (!response.ok) {
        throw new Error('Cart update failed');
      }


      const updatedCart = await response.json();


      /*
        Shopify has now updated the real cart.
        Reloading the page keeps all Shopify theme
        cart data, totals and line items in sync.
      */

      window.location.reload();

    } catch (error) {

      console.error('Cart update error:', error);

      if (cartWrapper) {
        cartWrapper.classList.remove('is-loading');
      }

      alert('Something went wrong while updating your cart. Please try again.');

    }

  }


  /* =======================================================
     QUANTITY BUTTONS
     ======================================================= */

  cart.addEventListener('click', function (event) {

    const minusButton =
      event.target.closest('[data-quantity-minus]');

    const plusButton =
      event.target.closest('[data-quantity-plus]');

    const removeButton =
      event.target.closest('[data-remove-item]');


    /* -----------------------------------------------------
       MINUS
       ----------------------------------------------------- */

    if (minusButton) {

      const item = minusButton.closest('[data-cart-item]');

      if (!item) {
        return;
      }

      const line = Number(item.dataset.line);

      const input =
        item.querySelector('[data-quantity-input]');

      if (!input) {
        return;
      }

      const currentQuantity =
        Number(input.value) || 1;

      const newQuantity =
        Math.max(0, currentQuantity - 1);

      input.value = newQuantity;

      updateCart(line, newQuantity);

      return;
    }


    /* -----------------------------------------------------
       PLUS
       ----------------------------------------------------- */

    if (plusButton) {

      const item = plusButton.closest('[data-cart-item]');

      if (!item) {
        return;
      }

      const line = Number(item.dataset.line);

      const input =
        item.querySelector('[data-quantity-input]');

      if (!input) {
        return;
      }

      const currentQuantity =
        Number(input.value) || 0;

      const newQuantity =
        currentQuantity + 1;

      input.value = newQuantity;

      updateCart(line, newQuantity);

      return;
    }


    /* -----------------------------------------------------
       REMOVE
       ----------------------------------------------------- */

    if (removeButton) {

      const item =
        removeButton.closest('[data-cart-item]');

      if (!item) {
        return;
      }

      const line =
        Number(item.dataset.line);

      updateCart(line, 0);

    }

  });


  /* =======================================================
     MANUAL QUANTITY INPUT
     ======================================================= */

  cart.addEventListener('change', function (event) {

    const input =
      event.target.closest('[data-quantity-input]');

    if (!input) {
      return;
    }

    const item =
      input.closest('[data-cart-item]');

    if (!item) {
      return;
    }

    const line =
      Number(item.dataset.line);

    let quantity =
      parseInt(input.value, 10);

    if (isNaN(quantity)) {
      quantity = 1;
    }

    quantity = Math.max(0, quantity);

    input.value = quantity;

    updateCart(line, quantity);

  });

});

</script>



<div class="test-2-cart">

  <div class="test-2-cart__container">

    {% if cart.item_count == 0 %}

      <!-- =====================================================
           EMPTY CART
           ===================================================== -->

      <div class="test-2-cart__empty">

        <div class="test-2-cart__empty-icon">
          +
        </div>

        <h1 class="test-2-cart__empty-title">
          Your cart is empty
        </h1>

        <p class="test-2-cart__empty-text">
          Looks like you haven't added anything to your cart yet.
        </p>

        <a
          href="{{ routes.root_url }}"
          class="test-2-cart__continue"
        >
          Continue Shopping
        </a>

      </div>

    {% else %}

      <!-- =====================================================
           CART HEADER
           ===================================================== -->

      <div class="test-2-cart__header">

        <div>
          <p class="test-2-cart__eyebrow">
            SHOPPING BAG
          </p>

          <h1 class="test-2-cart__heading">
            Your Cart
          </h1>
        </div>

        <p class="test-2-cart__count">
          {{ cart.item_count }}
          {% if cart.item_count == 1 %}
            item
          {% else %}
            items
          {% endif %}
        </p>

      </div>


      <!-- =====================================================
           CART
           ===================================================== -->

      <form
        action="{{ routes.cart_url }}"
        method="post"
        class="test-2-cart__form"
        data-cart-form
      >

        <!-- ===================================================
             CART ITEMS
             =================================================== -->

        <div class="test-2-cart__items">

          <div class="test-2-cart__items-header">
            <span>PRODUCT</span>
            <span>PRICE</span>
          </div>


          {% for item in cart.items %}

            <article
              class="test-2-cart__item"
              data-cart-item
              data-line="{{ forloop.index }}"
            >

              <!-- IMAGE -->

              <div class="test-2-cart__image">

                <a href="{{ item.url }}">

                  {% if item.image %}

                    {{
                      item.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600',
                        sizes: '(min-width: 750px) 180px, 35vw',
                        alt: item.product.title | escape
                    }}

                  {% else %}

                    <div class="test-2-cart__image-placeholder">
                      No image
                    </div>

                  {% endif %}

                </a>

              </div>


              <!-- PRODUCT DETAILS -->

              <div class="test-2-cart__details">

                <div class="test-2-cart__product-top">

                  <div>

                    <a
                      href="{{ item.url }}"
                      class="test-2-cart__title"
                    >
                      {{ item.product.title }}
                    </a>


                    {% unless item.product.has_only_default_variant %}

                      <p class="test-2-cart__variant">
                        {{ item.variant.title }}
                      </p>

                    {% endunless %}


                    {% if item.selling_plan_allocation %}

                      <p class="test-2-cart__selling-plan">
                        {{ item.selling_plan_allocation.selling_plan.name }}
                      </p>

                    {% endif %}

                  </div>


                  <!-- DESKTOP PRICE -->

                  <div class="test-2-cart__desktop-price">

                    <span data-line-price>
                      {{ item.final_line_price | money }}
                    </span>

                    {% if item.original_line_price > item.final_line_price %}

                      <span class="test-2-cart__old-price">
                        {{ item.original_line_price | money }}
                      </span>

                    {% endif %}

                  </div>

                </div>


                <!-- BOTTOM -->

                <div class="test-2-cart__product-bottom">

                  <!-- QUANTITY -->

                  <div class="test-2-cart__quantity">

                    <span class="test-2-cart__quantity-label">
                      Quantity
                    </span>

                    <div class="test-2-cart__quantity-control">

                      <button
                        type="button"
                        class="test-2-cart__quantity-button"
                        data-quantity-minus
                        aria-label="Decrease quantity"
                      >
                        −
                      </button>


                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        step="1"
                        class="test-2-cart__quantity-input"
                        data-quantity-input
                        aria-label="Quantity for {{ item.product.title | escape }}"
                      >


                      <button
                        type="button"
                        class="test-2-cart__quantity-button"
                        data-quantity-plus
                        aria-label="Increase quantity"
                      >
                        +
                      </button>

                    </div>

                  </div>


                  <!-- REMOVE -->

                  <button
                    type="button"
                    class="test-2-cart__remove"
                    data-remove-item
                  >
                    Remove
                  </button>

                </div>


                <!-- MOBILE PRICE -->

                <div class="test-2-cart__mobile-price">

                  <span data-mobile-line-price>
                    {{ item.final_line_price | money }}
                  </span>

                </div>

              </div>

            </article>

          {% endfor %}

        </div>


        <!-- ===================================================
             SUMMARY
             =================================================== -->

        <aside class="test-2-cart__summary">

          <div class="test-2-cart__summary-inner">

            <p class="test-2-cart__summary-eyebrow">
              ORDER SUMMARY
            </p>


            <div class="test-2-cart__summary-row">

              <span>
                Subtotal
              </span>

              <strong data-cart-subtotal>
                {{ cart.total_price | money }}
              </strong>

            </div>


            <p class="test-2-cart__shipping-note">
              Shipping and taxes calculated at checkout.
            </p>


            <button
              type="submit"
              name="checkout"
              class="test-2-cart__checkout"
            >
              <span>
                Proceed to Checkout
              </span>

              <span>
                →
              </span>
            </button>


            <a
              href="{{ routes.root_url }}"
              class="test-2-cart__continue-link"
            >
              Continue Shopping
            </a>


            <div class="test-2-cart__secure">

              <span class="test-2-cart__secure-icon">
                ✓
              </span>

              <span>
                Secure checkout
              </span>

            </div>

          </div>

        </aside>

      </form>

    {% endif %}

  </div>

</div>


<style>

/* =========================================================
   TEST 2 CART
   ========================================================= */


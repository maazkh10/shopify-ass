<section class="hello-world">
  <h1>{{ section.settings.heading }}</h1>

  <p>{{ section.settings.description }}</p>
</section>

<style>
  .hello-world {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    background: #f5f5f5;
  }

  .hello-world h1 {
    margin: 0 0 16px;
    font-size: 48px;
  }

  .hello-world p {
    margin: 0;
    font-size: 20px;
  }
</style>

{% schema %}
{
  "name": "Hello World",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HELLO SHOPIFY 👋"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "My Shopify theme is working!"
    }
  ],
  "presets": [
    {
      "name": "Hello World"
    }
  ]
}
{% endschema %}